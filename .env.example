# Copy to .env and fill in. .env is git-ignored; never commit it.

# --- Android release signing (read by PulseBuilder.cs and Tools/*.ps1) ---
# Final package name for Google Play
PULSE_APPLICATION_ID=
# Absolute path to the upload keystore (.p12 / .jks)
PULSE_KEYSTORE=
# Key alias inside the keystore
PULSE_KEY_ALIAS=
# Keystore and key passwords (leave empty to use Signing/password.dpapi via Tools/BuildRelease.ps1)
PULSE_KEYSTORE_PASSWORD=
PULSE_KEY_PASSWORD=

# --- Unity Cloud (reference only; Unity reads these from ProjectSettings.asset) ---
UNITY_CLOUD_PROJECT_ID=
UNITY_ORGANIZATION_ID=

# --- Epic Online Services (internet play; client creds ship inside the game by design) ---
EOS_PRODUCT_ID=
EOS_SANDBOX_ID=
EOS_DEPLOYMENT_ID=
EOS_CLIENT_ID=
EOS_CLIENT_SECRET=
EOS_ENCRYPTION_KEY=
